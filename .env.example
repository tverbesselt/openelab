# Firebase-configuratie voor Open E-lab.
# Kopieer dit bestand naar .env.local en vul de waarden in uit de Firebase-console
# (Projectinstellingen > Je apps > Web-app). Dit zijn publieke waarden, geen geheimen;
# de echte beveiliging zit in firestore.rules en storage.rules.
#
# Laat alles leeg om Open E-lab zonder Firebase in demomodus te draaien (alle gegevens
# blijven in de browser). Zie docs/INSTALLEREN.md.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optioneel: naam van een aparte Firestore-databank binnen het project. Leeg = (default).
NEXT_PUBLIC_FIRESTORE_DATABASE=

# Optioneel: Storage-bucket voor foto's en audio bij quizvragen (regels in storage.rules).
# Leeg = uploaden werkt alleen lokaal als data-URL, zoals in demomodus.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Alleen voor lokaal testen tegen de Firebase-emulators. Leeg laten op productie.
NEXT_PUBLIC_FIRESTORE_EMULATOR=

# Optioneel: Inlezen en Audio naar tekst (/api/inlezen) gebruiken Whisper van OpenAI.
# Dit IS een geheim: zet hem alleen in .env.local of op de server, nooit in git.
# Je kan hem ook via Beheer > Spraak invullen (daarvoor heeft de server Firestore-toegang nodig).
OPENAI_API_KEY=

# Optioneel (alleen nodig op Vercel/Docker/eigen server als je de OpenAI-sleutel via Beheer > Spraak
# bewaart): de volledige JSON-inhoud van een Google Cloud serviceaccount met rol Cloud Datastore User.
FIREBASE_SERVICE_ACCOUNT=
