{
  "name": "open-elab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:rules": "firebase emulators:exec --project demo-open-elab --only firestore,storage \"vitest run\"",
    "test:e2e": "firebase emulators:exec --project demo-open-elab --only firestore,auth \"playwright test\"",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:rules"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.0.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "firebase-tools": "^15.33.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
